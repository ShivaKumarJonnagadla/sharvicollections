# ---------------------------------------------------------------------------
# Sharvi Collections — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file. Secrets must only live in the deployment
# platform's environment configuration (Vercel / Neon / Cloudinary dashboards).
# ---------------------------------------------------------------------------

# ----- Database (Neon PostgreSQL) -----
# Pooled connection string used by the app at runtime (PgBouncer).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/sharvi?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/sharvi?sslmode=require"

# ----- Authentication -----
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-access-token-secret"
JWT_REFRESH_SECRET="change-me-refresh-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ----- Server -----
NODE_ENV="development"
PORT="4000"
API_VERSION="v1"
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:5173"
# Cookie domain (leave empty for localhost). e.g. .sharvicollections.se
COOKIE_DOMAIN=""

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="sharvi-collections"

# ----- Email (Resend) — order confirmation emails -----
# Get a key at https://resend.com. For production delivery to customers you must
# verify a sending domain and set EMAIL_FROM to an address on that domain.
RESEND_API_KEY=""
EMAIL_FROM="Sharvi Collections <onboarding@resend.dev>"
# Store owner — always emailed on new orders. While using the shared
# onboarding@resend.dev sender, this MUST be your Resend account email.
ORDER_NOTIFY_EMAIL=""
# Public site URL used in order emails / tracking links.
SITE_URL="http://localhost:5173"

# ----- Seed / bootstrap admin (used only by prisma/seed.ts) -----
SEED_ADMIN_EMAIL="admin@sharvicollections.se"
SEED_ADMIN_PASSWORD="ChangeThisStrongPassword123!"
SEED_ADMIN_NAME="Sharvi Admin"

# ----- Frontend (Vite) — must be prefixed with VITE_ -----
VITE_API_URL="http://localhost:4000/api/v1"
VITE_SITE_URL="http://localhost:5173"
VITE_WHATSAPP_NUMBER="+46769609978"
VITE_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/H2h4AXSZytm9yCqNIbrqgm"
VITE_CONTACT_PHONE="0769609978"
